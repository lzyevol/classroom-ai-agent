# Copy this file to .env before running Docker Compose.
# Do not commit the resulting .env file.

# Neo4j requires a password with at least eight characters.
NEO4J_PASSWORD=change-me-neo4j

# Optional AI providers. Leave blank to run without the corresponding cloud capability.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_TTS_API_KEY=

# Demo account defaults. The bundled seed database already contains these accounts;
# changing these values does not rewrite passwords in an existing seed/runtime database.
DEMO_STUDENT_PASSWORD=student123
DEMO_TEACHER_PASSWORD=teacher123
DEMO_ADMIN_PASSWORD=admin123
AUTH_SESSION_DAYS=7

# Host ports. Change them if these ports are already occupied.
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
