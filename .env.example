# 不要把真实密钥写入此文件或提交到Git。
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 仅由 FastAPI 后端读取，浏览器不会保存该密钥。
QWEN_TTS_API_KEY=your_qwen_tts_api_key_here

NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Redis backs async job state for long-running generation tasks.
# Include the password inline when the server has requirepass set.
REDIS_URL=redis://:your_redis_password_here@127.0.0.1:6379/0

# Optional absolute or relative SQLite database path. Leave empty for data/classroom.db.
SQLITE_DB_PATH=

# Login session lifetime in days.
AUTH_SESSION_DAYS=7

# Local demo accounts. Change these values outside local development.
DEMO_STUDENT_PASSWORD=student123
DEMO_TEACHER_PASSWORD=teacher123
DEMO_ADMIN_PASSWORD=admin123
