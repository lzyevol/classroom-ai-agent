# 后端环境变量示例（复制为 .env 后填写本地值；.env 不提交，真实 Key 只存在于本机）
# 由 B（feature/backend-agent）维护后端/模型配置；C 最终汇总统一启动说明。

# Neo4j（A 提供数据与图谱；本地默认值见 app/config.py）
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# DeepSeek 模型（缺 DEEPSEEK_API_KEY 时后端返回明确的配置错误 503，不会伪装成证据不足）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Redis（课件任务队列等）
REDIS_URL=redis://127.0.0.1:6379/0

# SQLite：留空则使用 data/classroom.db（不提交）
# SQLITE_DB_PATH=/absolute/path/to/classroom.db

# 演示账号密码（首次建库时写入）
DEMO_STUDENT_PASSWORD=student123
DEMO_TEACHER_PASSWORD=teacher123
DEMO_ADMIN_PASSWORD=admin123

# 登录会话有效期（天）
AUTH_SESSION_DAYS=7
